---
const year = new Date().getFullYear();
---

<footer class="mt-32 border-t" style="border-color: var(--color-line);">
  <div class="section py-12">
    <div class="grid gap-8 md:grid-cols-3">
      <div>
        <div class="font-display text-lg font-semibold">
          Nrvana<span style="color: var(--color-accent);">·</span>AI
        </div>
        <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">
          Practical AI for people and small businesses. More done, hours back, yours to keep.
        </p>
      </div>
      <div class="text-sm" style="color: var(--color-ink-soft);">
        <div class="font-medium text-[var(--color-ink)]">Start here</div>
        <ul class="mt-3 space-y-2">
          <li><a href="/services/snapshot" class="hover:text-[var(--color-ink)]">Acceleration Snapshot — $450</a></li>
          <li><a href="/services/personal-cortex" class="hover:text-[var(--color-ink)]">Your Personal Setup</a></li>
          <li><a href="/services/diagnostic" class="hover:text-[var(--color-ink)]">Team Review</a></li>
          <li><a href="/contact" class="hover:text-[var(--color-ink)]">Just say hi</a></li>
        </ul>
      </div>
      <div class="text-sm" style="color: var(--color-ink-soft);">
        <div class="font-medium text-[var(--color-ink)]">Also from Nrvana</div>
        <ul class="mt-3 space-y-2">
          <li><a href="https://studio.nrvana.com" class="hover:text-[var(--color-ink)]">AI Design Studio — studio.nrvana.com</a></li>
          <li><a href="/memos" class="hover:text-[var(--color-ink)]">Memos</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-10 flex items-center justify-between text-xs" style="color: var(--color-ink-mute);">
      <div>© {year} Nrvana</div>
      <div class="flex gap-5">
        <a href="/legal/privacy" class="hover:text-[var(--color-ink)]">Privacy</a>
        <a href="/legal/terms" class="hover:text-[var(--color-ink)]">Terms</a>
      </div>
    </div>
  </div>
</footer>
