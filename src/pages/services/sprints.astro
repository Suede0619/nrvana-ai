---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF } from "../../siteConfig";

const modules = [
  { name: "Inbox helper", desc: "Sorts your email and drafts replies in your voice. You just glance, approve, and send." },
  { name: "Research helper", desc: "Ask a question, get a clear briefing with sources in minutes, not an afternoon." },
  { name: "Follow-up helper", desc: "Writes every sales and client follow-up for you to approve. Nothing slips through the cracks." },
  { name: "Support helper", desc: "Reads incoming questions, drafts friendly answers, and flags the ones that need you." },
  { name: "Meeting memory", desc: "Turns your calls into a searchable team memory. Every decision, easy to find again." },
];
---

<BaseLayout title="Done-for-You Setup · Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For your team · 2–50 people</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight max-w-3xl">
      One time-saving workflow, <em>built and working in weeks.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Pick the one that would help most. We build it, set it up for your team, and stay on hand for a month
      to make sure everyone's comfortable. Simple as that.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-3"
         style="border-color: var(--color-line); background-color: white;">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-xl font-semibold">2–4 weeks</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">You get</div><div class="mt-1 font-display text-xl font-semibold">One helper, live</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Price</div><div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$5k–$15k</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">Helpers we can set up for you</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {modules.map((m) => (
        <div class="rounded-2xl border p-6" style="border-color: var(--color-line); background-color: white;">
          <h3 class="font-display text-xl font-medium">{m.name}</h3>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{m.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Tell us what would help most.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Start with a free chat and we'll point you to the helper with the biggest payoff.</p>
      <div class="mt-8">
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">Book a free 30-minute call</a>
      </div>
    </div>
  </section>
</BaseLayout>
