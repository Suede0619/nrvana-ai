---
import BaseLayout from "../../layouts/BaseLayout.astro";

const modules = [
  { name: "Inbox Triage", desc: "Agent reads, drafts, categorizes. Humans approve." },
  { name: "Research", desc: "Multi-source briefing with cited findings, on demand." },
  { name: "Sales Follow-Up", desc: "Drafts every follow-up. Never sends. Human signs off." },
  { name: "Customer Support Triage", desc: "Agent classifies, drafts a reply, escalates the rest." },
  { name: "Meeting Memory", desc: "Transcripts → searchable team memory. Decisions never get lost again." },
];
---

<BaseLayout title="Workflow Installation Sprint — Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For your team · 2–50 people</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight max-w-3xl">
      One workflow. Live in 2–4 weeks. <em>End to end.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Pick a module. We install it. Eval harness, runbook, and a 30-day support window included.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-3"
         style="border-color: var(--color-line); background-color: white;">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-xl font-semibold">2–4 weeks</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Outcome</div><div class="mt-1 font-display text-xl font-semibold">1 module live</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Fee</div><div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$5k–$15k</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">Modules we've templated</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {modules.map((m) => (
        <div class="rounded-2xl border p-6" style="border-color: var(--color-line); background-color: white;">
          <h3 class="font-display text-xl font-medium">{m.name}</h3>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{m.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Pick a module. We start in a week.</h2>
      <div class="mt-8">
        <a href="/contact?ref=sprint" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">Talk through a Sprint →</a>
      </div>
    </div>
  </section>
</BaseLayout>
