---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Retainers — Nrvana AI">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight max-w-3xl">
      Compound. <em>One workflow at a time.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      After Setup or a Sprint, retainers keep your AI getting smarter — not staler.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: white;">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For you · Individual</div>
        <h2 class="mt-3 font-display text-2xl font-semibold">Acceleration Retainer</h2>
        <div class="mt-2 font-display text-2xl">$500–$1,500 / mo</div>
        <ul class="mt-6 space-y-2 text-sm" style="color: var(--color-ink-soft);">
          <li>· 1 new workflow installed each month</li>
          <li>· Memory + Context maintenance (your setup gets smarter, not staler)</li>
          <li>· 60 minutes of synchronous problem-solving</li>
          <li>· Access to new modules as we ship them</li>
        </ul>
      </div>

      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: white;">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For your team · 2–50</div>
        <h2 class="mt-3 font-display text-2xl font-semibold">Team Cortex Retainer</h2>
        <div class="mt-2 font-display text-2xl">$2,500–$7,500 / mo</div>
        <ul class="mt-6 space-y-2 text-sm" style="color: var(--color-ink-soft);">
          <li>· Shared team memory + procedural knowledge maintenance</li>
          <li>· 1 module installed or upgraded per month</li>
          <li>· Monthly eval report with recommendations</li>
          <li>· Async + 90 minutes synchronous time / month</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-2xl">Cancel anytime. <em>The setup is still yours.</em></p>
      <div class="mt-6">
        <a href="/contact?ref=retainer" class="btn-primary">Talk through a retainer</a>
      </div>
    </div>
  </section>
</BaseLayout>
