---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF } from "../../siteConfig";

const deliverables = [
  { name: "Your Time-Back Map", desc: "Where your team's hours actually go each week — and the biggest ones AI can hand back, ranked by impact." },
  { name: "Your Tool Picture", desc: "What you're paying for now, what's worth keeping, and the handful of tools we'd actually set up for your team." },
  { name: "Your People + AI Plan", desc: "For each person: what AI takes off their plate, and where it frees them to grow into higher-value work. The page that gets your team excited, not worried." },
  { name: "Your 90-Day Plan", desc: "What we'd set up first, second, and third — in plain steps, with the hours-back you can expect from each." },
  { name: "Your Quick Wins", desc: "Two or three things your team can start using the week after we finish. Momentum from day one." },
];
---

<BaseLayout title="Team Review — $2,500 · Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For your team · 2–50 people</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight max-w-3xl">
      See exactly how AI can give your team <em>its time back.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five days. Five plain-English deliverables. A simple 90-day plan that gets everyone doing
      more of the work they're best at — and excited about it.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: white;">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-xl font-semibold">5 days</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">You get</div><div class="mt-1 font-display text-xl font-semibold">5 deliverables</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Team time</div><div class="mt-1 font-display text-xl font-semibold">A few hours</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Price</div><div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$2,500 flat</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">What your team walks away with</h2>
    <ol class="mt-8 space-y-6">
      {deliverables.map((d, i) => (
        <li class="flex gap-5">
          <div class="font-display text-2xl font-semibold" style="color: var(--color-accent-deep); min-width: 2rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-xl font-medium">{d.name}</h3>
            <p class="mt-1 text-sm" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-2xl">
        The plan is yours. Your privacy is yours. <em>The wins are yours.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Everything we learn about your team stays private to your team. Every deliverable is yours to keep.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Ready when you are.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Book the Team Review — or start with a free chat to see if it's a fit.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">Book a free 20-minute call</a>
        <a href="/contact?ref=team-review" class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">Book the Team Review — $2,500</a>
      </div>
    </div>
  </section>
</BaseLayout>
