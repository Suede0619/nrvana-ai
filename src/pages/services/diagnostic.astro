---
import BaseLayout from "../../layouts/BaseLayout.astro";

const deliverables = [
  { name: "Your Stack Map", desc: "Which agentic-stack layers your team has today, scored 0–3 per layer." },
  { name: "Your Plane Health Chart", desc: "Identity, Memory, Context, Policy, Telemetry — each scored 0–3." },
  { name: "Your Binding Constraint", desc: "The one missing layer that is capping every AI initiative you've tried." },
  { name: "Your 90-Day Acceleration Plan", desc: "What to install first, second, third — with effort and expected hours-back." },
  { name: "\"What This Will Not Replace\" appendix", desc: "Contractual: which roles AI will amplify, which roles are off-limits. The document that lets a worried team relax." },
];
---

<BaseLayout title="Agentic Readiness Diagnostic — $2,500 · Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For your team · 2–50 people</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight max-w-3xl">
      The diagnostic that names what's missing — <em>and what you'll never replace.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five days. Five named artifacts. A 90-day plan that protects every role on your team.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: white;">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-xl font-semibold">5 days</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Deliverables</div><div class="mt-1 font-display text-xl font-semibold">5 named</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Team time</div><div class="mt-1 font-display text-xl font-semibold">8–12 hours</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Fee</div><div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$2,500 flat</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">What your team walks away with</h2>
    <ol class="mt-8 space-y-6">
      {deliverables.map((d, i) => (
        <li class="flex gap-5">
          <div class="font-display text-2xl font-semibold" style="color: var(--color-accent-deep); min-width: 2rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-xl font-medium">{d.name}</h3>
            <p class="mt-1 text-sm" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-2xl">
        Plan is yours. Privacy is yours. <em>Outcomes are yours.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        We will not store, sell, or reuse anything we learn about your team or your data. Every artifact is yours to keep.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Book the Diagnostic.</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact?ref=diagnostic" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">Book — $2,500</a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">Talk first</a>
      </div>
    </div>
  </section>
</BaseLayout>
