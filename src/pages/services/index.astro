---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF } from "../../siteConfig";

const ladder = [
  {
    step: "01",
    title: "Start with a free call",
    desc: "A relaxed 30-minute chat about your day and where AI could help. No pitch, no jargon, no commitment.",
    href: CALL_HREF,
    price: "Free · 20 min",
  },
  {
    step: "02",
    title: "Get a Snapshot",
    desc: "In 3 days we map your time leaks and hand you a simple plan plus your first AI setup. $450, yours to keep.",
    href: "/services/snapshot",
    price: "$450 · 3 days",
  },
  {
    step: "03",
    title: "Have us set it all up",
    desc: "We build the full thing around you — and keep improving it month to month if you want us to.",
    href: "/services/personal-cortex",
    price: "$2,500 · 5–7 days",
  },
];

const offerings = [
  { name: "The Snapshot", audience: "Individual", length: "3 days", price: "$450", href: "/services/snapshot", out: "Plan + your first AI setup" },
  { name: "Your Personal Setup", audience: "Individual", length: "5–7 days", price: "$2,500", href: "/services/personal-cortex", out: "AI set up around you" },
  { name: "Monthly Support", audience: "Individual", length: "ongoing", price: "$500–$1,500/mo", href: "/services/retainers", out: "One new win a month" },
  { name: "Team Review", audience: "Team", length: "5 days", price: "$2,500", href: "/services/diagnostic", out: "Plan + quick wins for the team" },
  { name: "Done-for-You Setup", audience: "Team", length: "2–4 weeks", price: "$5k–$15k", href: "/services/sprints", out: "A full workflow, live and working" },
  { name: "Safety & Quality Setup", audience: "Team", length: "1–2 weeks", price: "$4k–$8k", href: "/services/governance", out: "Confidence it's all working right" },
  { name: "Team Monthly Support", audience: "Team", length: "ongoing", price: "$2.5k–$7.5k/mo", href: "/services/retainers", out: "Ongoing improvements" },
];
---

<BaseLayout title="Services — Nrvana AI">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      Start small. <em>Grow at your pace.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      A free chat to see if it's a fit. A Snapshot to get going. A full setup when you're ready.
      No pressure to climb the ladder — pick the rung that fits you today.
    </p>
  </section>

  <section class="section pb-20">
    <div class="grid gap-6 md:grid-cols-3">
      {ladder.map((l) => (
        <a href={l.href} class="rounded-2xl border p-7 transition hover:-translate-y-0.5"
           style="border-color: var(--color-line); background-color: white;">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">{l.step}</div>
          <h3 class="mt-3 font-display text-2xl font-semibold">{l.title}</h3>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{l.desc}</p>
          <div class="mt-5 text-sm font-medium">{l.price} →</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">Everything we offer</h2>
    <p class="mt-2 text-sm" style="color: var(--color-ink-mute);">Most people start with a free call or the Snapshot. The rest is here when you need it.</p>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b text-left text-xs uppercase tracking-wider"
              style="border-color: var(--color-line); color: var(--color-ink-mute);">
            <th class="py-3 pr-4">What it is</th>
            <th class="py-3 pr-4">For</th>
            <th class="py-3 pr-4">Length</th>
            <th class="py-3 pr-4">Price</th>
            <th class="py-3 pr-4">You get</th>
            <th class="py-3"></th>
          </tr>
        </thead>
        <tbody>
          {offerings.map((o) => (
            <tr class="border-b" style="border-color: var(--color-line);">
              <td class="py-4 pr-4 font-medium">{o.name}</td>
              <td class="py-4 pr-4" style="color: var(--color-ink-soft);">{o.audience}</td>
              <td class="py-4 pr-4" style="color: var(--color-ink-soft);">{o.length}</td>
              <td class="py-4 pr-4 font-medium">{o.price}</td>
              <td class="py-4 pr-4" style="color: var(--color-ink-soft);">{o.out}</td>
              <td class="py-4"><a href={o.href} class="underline underline-offset-4">See →</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-2xl">Not sure where to start? <em>Let's just talk.</em></p>
      <div class="mt-6">
        <a href={CALL_HREF} class="btn-primary">Book a free 30-minute call</a>
      </div>
    </div>
  </section>
</BaseLayout>
