---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF, SNAPSHOT_HREF } from "../../siteConfig";

const deliverables = [
  { name: "Your AI profile", desc: "A simple file that captures how you think, your voice, and what matters to you. Load it into any AI tool and it instantly works like it knows you." },
  { name: "A memory that sticks", desc: "Your AI remembers your projects and past work, so you stop re-explaining yourself from scratch every time." },
  { name: "Set up in your tools", desc: "We get it working in the apps you already use day to day — ready to go, no fiddling." },
  { name: "Two time-savers, installed", desc: "Two of the workflows that'll save you the most time, built and running before we finish." },
  { name: "A 15-minute weekly habit", desc: "A tiny weekly routine that keeps it getting smarter as you go. We teach it; you own it." },
];
---

<BaseLayout title="Your Personal Setup — $2,500 · Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For you · Individual</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight max-w-3xl">
      Your AI shouldn't forget what you taught it last week. <em>Ours doesn't.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      We set up AI that actually knows you, remembers your work, and saves you hours — then hand it
      over for you to keep. We call it your Personal Cortex. You'll just call it a relief.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: white;">
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div><div class="mt-1 font-display text-xl font-semibold">5–7 days</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">You get</div><div class="mt-1 font-display text-xl font-semibold">5 deliverables</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div><div class="mt-1 font-display text-xl font-semibold">A few short calls</div></div>
      <div><div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Price</div><div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$2,500 flat</div></div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">What you walk away with</h2>
    <ol class="mt-8 space-y-6">
      {deliverables.map((d, i) => (
        <li class="flex gap-5">
          <div class="font-display text-2xl font-semibold" style="color: var(--color-accent-deep); min-width: 2rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-xl font-medium">{d.name}</h3>
            <p class="mt-1 text-sm" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-2xl">
        It goes where you go. <em>Yours to keep.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Your setup works with whatever AI tools you choose, today and in the future. It's yours — it travels with you, always.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Ready to feel the difference?</h2>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={SNAPSHOT_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">Book — $2,500</a>
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 underline underline-offset-4"
           style="color: var(--color-canvas-soft);">Book a free 20-minute call first</a>
      </div>
    </div>
  </section>
</BaseLayout>
