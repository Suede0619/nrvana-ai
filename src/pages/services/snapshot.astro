---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF, SNAPSHOT_HREF } from "../../siteConfig";

const deliverables = [
  { name: "Your Time-Back Map", desc: "A clear picture of where your hours actually go each week, with the three biggest ones AI can quietly take off your plate." },
  { name: "Your Tool Check", desc: "Which AI tools are worth paying for, which to drop, and which one to start with. No overwhelm, just a short honest shortlist." },
  { name: "Your 30-Day Plan", desc: "The first few wins, in plain steps, in the order we'd do them. Simple enough to follow on your own if you want to." },
  { name: "Your Starter Setup", desc: "A ready-to-use AI setup that already knows your style, your goals, and the way you work. You just open it and go." },
  { name: "Your Next Step", desc: "An honest recommendation: keep going on your own, or have us set up the rest for you. Your call, zero pressure." },
];

const schedule = [
  { day: "Day 1", title: "A friendly chat", desc: "45 minutes with us. We learn how your week works. You don't prep anything. We guide the whole thing." },
  { day: "Day 2", title: "We do the work", desc: "We build your map, your plan, and your starter setup. You carry on with your day." },
  { day: "Day 3", title: "We walk you through it", desc: "60 minutes together. We hand it all over and make sure you feel confident using it." },
];
---

<BaseLayout title="The Snapshot ($450) · Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For you · Individual</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight">
      See exactly where AI can save you time. <em>In 3 days.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five plain-English deliverables. One simple plan. Your first AI setup, ready to use. All
      yours to keep. No tech background needed.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: white;">
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div>
        <div class="mt-1 font-display text-xl font-semibold">3 days</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">You get</div>
        <div class="mt-1 font-display text-xl font-semibold">5 deliverables</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div>
        <div class="mt-1 font-display text-xl font-semibold">~2 hours</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Price</div>
        <div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$450 flat</div>
      </div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">What you walk away with</h2>
    <ol class="mt-8 space-y-6">
      {deliverables.map((d, i) => (
        <li class="flex gap-5">
          <div class="font-display text-2xl font-semibold" style="color: var(--color-accent-deep); min-width: 2rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-xl font-medium">{d.name}</h3>
            <p class="mt-1 text-sm" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">How the three days go</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {schedule.map((s) => (
        <div class="rounded-2xl border p-6" style="border-color: var(--color-line); background-color: white;">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">{s.day}</div>
          <h4 class="mt-2 font-display text-xl font-medium">{s.title}</h4>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section py-16">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-3xl">
        The plan is yours. <em>Take it with you.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Everything above is yours to keep. No retainer, no lock-in, no pressure to continue.
      </p>
    </div>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Ready when you are.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Book the Snapshot, or start with a free chat if you'd like to talk first.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={SNAPSHOT_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">
          Book the Snapshot ($450)
        </a>
        <a href={CALL_HREF} class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium underline underline-offset-4"
           style="color: var(--color-canvas-soft);">
          Book a free 30-minute call
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
