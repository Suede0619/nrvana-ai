---
import BaseLayout from "../../layouts/BaseLayout.astro";

const deliverables = [
  { name: "Your Time Audit", desc: "Where your hours actually go, sourced from one week of self-report plus tool exports." },
  { name: "Your Tool Map", desc: "Every AI / SaaS tool you pay for, mapped to outcomes. Consolidation targets named." },
  { name: "Your Acceleration Plan (30 / 60 / 90)", desc: "The three workflows we'd install first — in order." },
  { name: "Your Starter Cortex", desc: "A markdown file describing you that any LLM can load. Tone, goals, constraints, vocabulary." },
  { name: "Your Next Step", desc: "Stop, DIY from the plan, or continue with the full Personal Cortex Setup. Explicit recommendation." },
];

const schedule = [
  { day: "Day 1", title: "Intake call", desc: "45 minutes with us. Plus one week of tool exports you collect at your own pace." },
  { day: "Day 2", title: "Synthesis", desc: "We build the audit, the tool map, the plan, and your Starter Cortex." },
  { day: "Day 3", title: "Walkthrough", desc: "60-minute walkthrough. You keep every artifact." },
];

const notFor = [
  "Anyone shopping for AI to reduce headcount. That's not what we do.",
  "Anyone wanting a custom LLM trained or fine-tuned. We integrate; we don't train base models.",
  "Anyone wanting a strategy deck. We ship artifacts, not slides.",
];
---

<BaseLayout title="Acceleration Snapshot — $450 · Nrvana AI">
  <section class="section pt-20 pb-12">
    <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">For you · Individual</div>
    <h1 class="mt-4 font-display text-5xl font-semibold tracking-tight">
      See where your time is leaking. <em>In 3 days.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Five named artifacts. One acceleration plan. Yours regardless of what happens next.
    </p>
  </section>

  <section class="section py-8">
    <div class="grid gap-4 rounded-2xl border p-8 sm:grid-cols-4"
         style="border-color: var(--color-line); background-color: white;">
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Length</div>
        <div class="mt-1 font-display text-xl font-semibold">3 days</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Deliverables</div>
        <div class="mt-1 font-display text-xl font-semibold">5 named</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Your time</div>
        <div class="mt-1 font-display text-xl font-semibold">2–3 hours</div>
      </div>
      <div>
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-ink-mute);">Fee</div>
        <div class="mt-1 font-display text-xl font-semibold" style="color: var(--color-accent-deep);">$450 flat</div>
      </div>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">What you walk away with</h2>
    <ol class="mt-8 space-y-6">
      {deliverables.map((d, i) => (
        <li class="flex gap-5">
          <div class="font-display text-2xl font-semibold" style="color: var(--color-accent-deep); min-width: 2rem;">
            {String(i + 1).padStart(2, "0")}
          </div>
          <div>
            <h3 class="font-display text-xl font-medium">{d.name}</h3>
            <p class="mt-1 text-sm" style="color: var(--color-ink-soft);">{d.desc}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-3xl font-semibold">The three days</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {schedule.map((s) => (
        <div class="rounded-2xl border p-6" style="border-color: var(--color-line); background-color: white;">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">{s.day}</div>
          <h4 class="mt-2 font-display text-xl font-medium">{s.title}</h4>
          <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">{s.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section py-16">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <p class="font-display text-3xl">
        The plan is yours. <em>Regardless of what comes next.</em>
      </p>
      <p class="mt-3" style="color: var(--color-ink-soft);">
        Every artifact above is yours to keep. No retainer. No lock-in. No upsell pressure.
      </p>
    </div>
  </section>

  <section class="section py-12">
    <h2 class="font-display text-2xl font-semibold">This is not for you if…</h2>
    <ul class="mt-6 space-y-3 text-sm" style="color: var(--color-ink-soft);">
      {notFor.map((n) => <li>· {n}</li>)}
    </ul>
  </section>

  <section class="section py-20">
    <div class="rounded-2xl p-10 text-center" style="background-color: var(--color-ink); color: var(--color-canvas);">
      <h2 class="font-display text-3xl font-semibold">Book the Snapshot.</h2>
      <p class="mt-3" style="color: var(--color-canvas-soft);">Launch price. Three days. Yours regardless.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/contact?ref=snapshot" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium"
           style="background-color: var(--color-canvas); color: var(--color-ink);">
          Book — $450
        </a>
        <a href="/contact" class="inline-flex items-center gap-2 rounded-md px-6 py-3 font-medium underline underline-offset-4"
           style="color: var(--color-canvas-soft);">
          Talk first — just say hi
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
