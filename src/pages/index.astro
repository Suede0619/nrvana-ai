---
import BaseLayout from "../layouts/BaseLayout.astro";

const stats = [
  { num: "18%", label: "reasoning gains from sleep-time compute" },
  { num: "90%+", label: "outperformance from well-orchestrated multi-agent setups" },
  { num: "5×", label: "revenue per employee at AI-native firms" },
  { num: "<1%", label: "of agent cost is the model — the rest is setup. We do the setup." },
];

const doorways = [
  {
    label: "For you",
    headline: "You, faster.",
    body: "Solo professionals, founders, operators, creators. We install your AI memory, your context, your top three workflows — in days.",
    cta: { href: "/services/snapshot", label: "Start with the Snapshot — $450" },
    sub: { href: "/services/personal-cortex", label: "Or the full Personal Cortex →" },
  },
  {
    label: "For your team",
    headline: "Your team, unstoppable.",
    body: "2 to 50 people. We map your agentic stack, name the binding constraint, and ship a 90-day plan that protects every role.",
    cta: { href: "/services/diagnostic", label: "Start with the Diagnostic — $2,500" },
    sub: { href: "/services/sprints", label: "Or a Workflow Sprint →" },
  },
];
---

<BaseLayout>
  <!-- HERO -->
  <section class="section pt-20 pb-16">
    <h1 class="font-display text-5xl md:text-6xl font-semibold tracking-tight max-w-3xl">
      You pay for AI tools. <em>We make them work for you.</em>
    </h1>
    <p class="mt-6 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Memory, context, workflows — installed in days. Built around how you actually work.
      We accelerate the humans doing the work. We never replace them.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-4">
      <a href="/services/snapshot" class="btn-primary">
        Book the Acceleration Snapshot — $450 · 3 days
      </a>
      <a href="/contact" class="btn-ghost">Just say hi</a>
    </div>
  </section>

  <!-- THESIS -->
  <section class="border-y py-20" style="border-color: var(--color-line); background-color: var(--color-canvas-soft);">
    <div class="section">
      <p class="mx-auto max-w-3xl text-center font-display text-3xl md:text-4xl leading-tight">
        We help people and small businesses thrive in the AI age — by
        <em>accelerating their work,</em> never by replacing them.
      </p>
    </div>
  </section>

  <!-- TWO DOORWAYS -->
  <section class="section py-20">
    <div class="grid gap-10 md:grid-cols-2">
      {doorways.map((d) => (
        <article class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: white;">
          <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">{d.label}</div>
          <h2 class="mt-3 font-display text-3xl font-semibold">{d.headline}</h2>
          <p class="mt-4" style="color: var(--color-ink-soft);">{d.body}</p>
          <div class="mt-8 flex flex-col gap-3">
            <a href={d.cta.href} class="btn-primary w-fit">{d.cta.label}</a>
            <a href={d.sub.href} class="text-sm underline underline-offset-4" style="color: var(--color-ink-soft);">
              {d.sub.label}
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- STAT SLAB -->
  <section class="section py-20">
    <div class="mb-10">
      <h3 class="font-display text-2xl font-semibold">What becomes possible.</h3>
      <p class="mt-2 text-sm" style="color: var(--color-ink-mute);">The numbers we lead with — chosen for what AI unlocks, not what it abandons.</p>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
      {stats.map((s) => (
        <div>
          <div class="font-display text-4xl font-semibold" style="color: var(--color-accent-deep);">{s.num}</div>
          <div class="mt-2 text-sm" style="color: var(--color-ink-soft);">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- METHOD PREVIEW -->
  <section class="section py-20">
    <div class="grid gap-12 md:grid-cols-3">
      <div>
        <div class="font-display text-3xl font-semibold">01</div>
        <h4 class="mt-2 font-display text-xl font-medium">Diagnose</h4>
        <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">
          Where is your time leaking? Where does AI extend you? We map it in days, not quarters.
        </p>
      </div>
      <div>
        <div class="font-display text-3xl font-semibold">02</div>
        <h4 class="mt-2 font-display text-xl font-medium">Install</h4>
        <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">
          Memory, context, workflows — built around how you actually work. Yours to keep.
        </p>
      </div>
      <div>
        <div class="font-display text-3xl font-semibold">03</div>
        <h4 class="mt-2 font-display text-xl font-medium">Compound</h4>
        <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">
          A 15-minute weekly ritual that makes your setup smarter every week. We teach it. You own it.
        </p>
      </div>
    </div>
    <div class="mt-12">
      <a href="/method" class="btn-ghost px-0">See the full method →</a>
    </div>
  </section>

  <!-- FIRST COHORT NOTE -->
  <section class="section py-20">
    <div class="rounded-2xl p-10" style="background-color: var(--color-canvas-soft);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">Our first cohort</div>
      <h3 class="mt-3 font-display text-2xl font-medium">
        We are running our first paid Snapshots now.
      </h3>
      <p class="mt-3 max-w-2xl" style="color: var(--color-ink-soft);">
        Names, photos, and outcomes from our first three clients will go here. If you want to be one of those names — at the launch price — that's why this page exists.
      </p>
      <div class="mt-6">
        <a href="/services/snapshot" class="btn-primary">Book the Snapshot — $450</a>
      </div>
    </div>
  </section>

  <!-- CLOSING CTA -->
  <section class="section py-24">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-display text-3xl md:text-4xl">
        The plan is yours. <em>Take it with you.</em>
      </p>
      <p class="mt-4" style="color: var(--color-ink-soft);">
        Every artifact we make for you is yours to keep. No retainer required. No lock-in.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/services/snapshot" class="btn-primary">Book the Acceleration Snapshot — $450</a>
        <a href="/contact" class="btn-ghost">Just say hi</a>
      </div>
    </div>
  </section>
</BaseLayout>
