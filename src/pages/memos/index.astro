---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CALL_HREF, BOOKING_EMAIL } from "../../siteConfig";

const upcoming = [
  "Why your AI keeps forgetting you — and the simple fix",
  "Get your evenings back: where AI actually saves time",
  "You don't need to be technical to use AI well",
  "How a one-person business can run like a team of ten",
  "Set it up once, save hours every week",
  "The 15-minute weekly habit that keeps your AI sharp",
];
---

<BaseLayout title="Memos — Nrvana AI">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      Memos.
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Short, plain-English notes on using AI to get your time back — no jargon, no hype.
    </p>
  </section>

  <section class="section py-12">
    <div class="rounded-2xl p-8" style="background-color: var(--color-canvas-soft);">
      <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">First six, in flight</div>
      <ul class="mt-4 space-y-3 font-display text-lg">
        {upcoming.map((u) => <li>· {u}</li>)}
      </ul>
      <p class="mt-6 text-sm" style="color: var(--color-ink-soft);">
        We're publishing one a week starting soon. Want them in your inbox? Email
        <a href={`mailto:${BOOKING_EMAIL}?subject=Memos`} class="underline underline-offset-4">{BOOKING_EMAIL}</a>.
      </p>
      <div class="mt-6">
        <a href={CALL_HREF} class="btn-primary">Book a free 20-minute call</a>
      </div>
    </div>
  </section>
</BaseLayout>
