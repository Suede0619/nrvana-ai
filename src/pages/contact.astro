---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact — Nrvana AI">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      Two doorways. <em>Pick whichever feels right.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Email us directly, or send a note from this page. We answer every message ourselves.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: white;">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">High commit</div>
        <h2 class="mt-3 font-display text-2xl font-semibold">Book the Snapshot</h2>
        <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">
          $450 · 3 days · 5 named artifacts. Booking link goes live as soon as Stripe + Calendly are wired.
        </p>
        <a href="mailto:hi@nrvana.com?subject=Snapshot%20booking" class="btn-primary mt-6">
          Email to book — hi@nrvana.com
        </a>
      </div>

      <div class="rounded-2xl border p-8" style="border-color: var(--color-line); background-color: white;">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">Just say hi</div>
        <h2 class="mt-3 font-display text-2xl font-semibold">Send a note</h2>
        <p class="mt-3 text-sm" style="color: var(--color-ink-soft);">
          A question, a hello, a "not sure if you can help with X." No qualifying questions, no funnel.
        </p>
        <a href="mailto:hi@nrvana.com" class="btn-primary mt-6" style="background-color: var(--color-accent-deep);">
          hi@nrvana.com
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
