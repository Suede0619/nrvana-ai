---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CALL_HREF, SNAPSHOT_HREF, BOOKING_EMAIL } from "../siteConfig";
---

<BaseLayout title="Contact — Nrvana AI">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      Two easy ways to start. <em>Pick whichever feels right.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Not sure yet? Start with a free chat. Ready to go? Book the Snapshot. Either way, you're
      talking to a real person — us.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border p-8 flex flex-col" style="border-color: var(--color-line); background-color: white;">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">Start free</div>
        <h2 class="mt-3 font-display text-2xl font-semibold">Book a free 20-minute call</h2>
        <p class="mt-3 text-sm flex-1" style="color: var(--color-ink-soft);">
          A relaxed, no-pressure chat about your day and where AI could save you time. No jargon,
          no pitch, no commitment. The easiest first step — and most people start here.
        </p>
        <a href={CALL_HREF} class="btn-primary mt-6">
          Book your free call →
        </a>
      </div>

      <div class="rounded-2xl border p-8 flex flex-col" style="border-color: var(--color-line); background-color: white;">
        <div class="text-xs uppercase tracking-widest" style="color: var(--color-accent-deep);">Ready to go</div>
        <h2 class="mt-3 font-display text-2xl font-semibold">Book the Snapshot — $450</h2>
        <p class="mt-3 text-sm flex-1" style="color: var(--color-ink-soft);">
          3 days. We map where your time is going and hand you a clear, simple plan plus your
          first AI setup. Everything is yours to keep.
        </p>
        <a href={SNAPSHOT_HREF} class="btn-primary mt-6" style="background-color: var(--color-accent-deep);">
          Book the Snapshot →
        </a>
      </div>
    </div>

    <p class="mt-8 text-sm" style="color: var(--color-ink-mute);">
      Prefer email? Just write us at <a href={`mailto:${BOOKING_EMAIL}`} class="underline underline-offset-4">{BOOKING_EMAIL}</a> — we answer every message ourselves.
    </p>
  </section>
</BaseLayout>
