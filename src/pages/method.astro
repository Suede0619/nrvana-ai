---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="The Nrvana Method">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      Three things most AI consultancies skip. <em>We start there.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Identity. Memory. Context. The unsexy layer that turns a generic chatbot into <em>your</em> agent.
    </p>
  </section>

  <section class="section py-12">
    <p class="text-sm" style="color: var(--color-ink-mute);">
      Method page — full version landing soon. Coming with it: the layer diagram, the five planes
      (Identity · Memory · Context · Policy · Telemetry), and a worked example heatmap.
    </p>
    <div class="mt-8">
      <a href="/services/snapshot" class="btn-primary">In the meantime — Book the Snapshot · $450</a>
    </div>
  </section>
</BaseLayout>
