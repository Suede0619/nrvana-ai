---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Privacy — Nrvana AI">
  <section class="section pt-20 pb-20 max-w-3xl">
    <h1 class="font-display text-4xl font-semibold">Privacy</h1>
    <p class="mt-6" style="color: var(--color-ink-soft);">
      Short version: we don't store, sell, or reuse anything we learn about you or your work without your written consent. We use a privacy-friendly analytics tool that does not set tracking cookies.
    </p>
    <p class="mt-4" style="color: var(--color-ink-soft);">
      Full policy landing soon. In the meantime, questions to <a href="mailto:hi@nrvana.com" class="underline underline-offset-4">hi@nrvana.com</a>.
    </p>
  </section>
</BaseLayout>
