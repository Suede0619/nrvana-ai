---
import BaseLayout from "../layouts/BaseLayout.astro";
import { CALL_HREF } from "../siteConfig";

const beliefs = [
  { t: "Your time is the point.", d: "We measure success in hours handed back to you and your team: time for the work only you can do." },
  { t: "Plain English, always.", d: "You should never feel talked down to or lost in jargon. If we can't explain it simply, we haven't finished thinking." },
  { t: "Built around you.", d: "We set AI up to know your style, your customers, and your way of working, so it feels like an extension of you." },
  { t: "Yours to keep.", d: "Everything we make is handed to you to own. Transparent prices, no lock-in, no surprises." },
];
---

<BaseLayout title="About · Nrvana AI">
  <section class="section pt-20 pb-12">
    <h1 class="font-display text-5xl font-semibold tracking-tight">
      We are people who believe <em>people are the point.</em>
    </h1>
    <p class="mt-5 max-w-2xl text-lg" style="color: var(--color-ink-soft);">
      Nrvana AI is a small, friendly practice that helps individuals and small teams get real,
      practical value from AI and get their time back.
    </p>
  </section>

  <section class="section py-12">
    <div class="grid gap-10 md:grid-cols-3">
      <div class="md:col-span-1">
        <div class="aspect-square w-full rounded-2xl overflow-hidden"
             style="background-color: var(--color-canvas-soft); border: 1px solid var(--color-line);">
          <img src="/images/stuart-paul.jpg" alt="Stuart Paul" class="w-full h-full object-cover"
               onerror="this.style.display='none'" />
        </div>
        <div class="mt-4 font-display text-xl font-semibold">Stuart Paul</div>
        <div class="text-sm" style="color: var(--color-ink-soft);">Founder</div>
        <div class="mt-3 text-sm" style="color: var(--color-ink-soft);">Stuart has spent years at the intersection of technology and small business, watching smart people burn time on things that should be automatic. Nrvana AI is his answer to that: practical AI setup that actually fits how individuals and small teams work, not how enterprise playbooks say they should.</div>
        <div class="mt-3 text-xs italic" style="color: var(--color-ink-mute);">"The goal is never to replace what you're good at. It's to clear the path so you can do more of it."</div>
      </div>
      <div class="md:col-span-2">
        <h2 class="font-display text-2xl font-semibold">Why Nrvana AI exists</h2>
        <p class="mt-4" style="color: var(--color-ink-soft);">
          Most AI help is built for big companies with big budgets. Or it's hype aimed at anyone
          with a credit card. That leaves a real gap: people and small teams who know AI matters,
          haven't had time to figure it out, and just want it to work.
        </p>
        <p class="mt-4" style="color: var(--color-ink-soft);">
          We fill that gap. We set up the context, memory, and workflows around how you already
          work, so your day gets lighter and your output gets bigger. Plain prices. Fast setup.
          Everything we build is yours to keep.
        </p>

        <h2 class="mt-10 font-display text-2xl font-semibold">What we believe</h2>
        <ul class="mt-4 space-y-4">
          {beliefs.map((b) => (
            <li>
              <div class="font-medium">{b.t}</div>
              <div class="mt-1 text-sm" style="color: var(--color-ink-soft);">{b.d}</div>
            </li>
          ))}
        </ul>

        <div class="mt-10">
          <a href={CALL_HREF} class="btn-primary">Book a free 30-minute call</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
